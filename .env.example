# Local Docker sandbox defaults.
# Copy to .env for local overrides, or run:
# docker compose --env-file .env.example up -d postgres mqtt-broker backend mqtt-simulator

HOST_IP=localhost
HYPERVISEUR_CONTAINER_PREFIX=hyperviseur
FRONTEND_HOST_PORT=3000
BACKEND_HTTPS_PORT=3001
BACKEND_INTERNAL_PORT=3002
POSTGRES_HOST_PORT=5433
MQTT_HOST_PORT=1883

# Frontend / API
NEXT_PUBLIC_API_URL=https://localhost:3001
NEXT_PUBLIC_RELAY_API_URL=https://localhost:3001/api/control
NEXT_PUBLIC_OPENWEATHER_API_KEY=
FRONTEND_BASE_URL=https://localhost:3000
CORS_ORIGINS=https://localhost:3000,http://localhost:3000

# Backend
PORT=3001
INTERNAL_PORT=3002
NODE_ENV=production
JWT_SECRET=local-dev-secret-change-me
POLLING_SERVICE_TOKEN=local-polling-token-change-me

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=hyperviseur
DB_SSL=false

# SMTP / notifications
AZURE_SENDER_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Azure AD placeholders
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Command sandbox
MQTT_URL=mqtt://mqtt-broker:1883
MQTT_CONNECT_TIMEOUT_MS=1500
MQTT_RECONNECT_MS=2000
MQTT_SIMULATOR_ACK_TOPIC=sandbox/acks
MQTT_SIMULATOR_MATCH_WINDOW_MS=300000
COMMAND_MODE=dry_run
COMMAND_LIVE_ENABLED=false
COMMAND_DRY_RUN_PUBLISH=true

# Modbus is not used by command endpoints while the dry-run kill switch is active.
MODBUS_TIMEOUT_MS=5000
