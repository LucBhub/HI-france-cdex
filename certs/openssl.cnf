
[req]
default_bits = 2048
prompt = no
default_md = sha256
distinguished_name = dn
req_extensions = req_ext
x509_extensions = v3_req

[dn]
C = FR
ST = Nouvelle-Aquitaine
L = Bordeaux
O = Reden Solar
OU = IT
CN = Hyperviseur Local

[req_ext]
subjectAltName = @alt_names

[v3_req]
subjectAltName = @alt_names

[alt_names]
DNS.1 = localhost
DNS.2 = backend
DNS.3 = frontend
IP.1 = 127.0.0.1
IP.2 = 10.14.10.14
